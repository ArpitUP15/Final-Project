OLLAMA_ENABLED=true
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=20
AUTODATAGEN_DB_PATH=./data/autodatagen.sqlite3

AUTODATAGEN_MAX_ITERATIONS=60
AUTODATAGEN_TARGET_ACCURACY=0.80
AUTODATAGEN_STRETCH_TARGET=0.90
AUTODATAGEN_TIME_BUDGET_SECONDS=420
AUTODATAGEN_CANDIDATE_TIMEOUT_SECONDS=45
AUTODATAGEN_WORKERS=1

# Maximum uploaded image ZIP size in MiB (raise only if RAM/disk can handle it)
AUTODATAGEN_MAX_IMAGE_ZIP_MIB=2048
